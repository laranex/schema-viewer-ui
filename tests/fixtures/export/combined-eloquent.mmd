erDiagram
    categories {
        bigint id PK
        bigint parent_id FK
        varchar name
    }
    comments {
        bigint id PK
        bigint user_id FK
        varchar commentable_type
        bigint commentable_id
        text body
        timestamp created_at
        timestamp updated_at
    }
    countries {
        bigint id PK
        char code UK
    }
    jobs {
        bigint id PK
        varchar queue
        longtext payload
    }
    oauth_clients {
        bigint id PK
        bigint user_id
        varchar name
    }
    posts {
        bigint id PK
        bigint user_id FK
        bigint editor_id
        bigint category_id FK
        varchar title
        enum status
        timestamp published_at
        timestamp created_at
        timestamp updated_at
    }
    role_user {
        bigint user_id PK, FK
        bigint role_id PK, FK
        timestamp assigned_at
    }
    roles {
        bigint id PK
        varchar name
    }
    taggables {
        bigint tag_id FK
        varchar taggable_type
        bigint taggable_id
    }
    tags {
        bigint id PK
        varchar name
    }
    users {
        bigint id PK
        bigint country_id FK
        varchar email UK
        varchar remember_token
        timestamp created_at
        timestamp updated_at
    }
    categories ||--o{ categories : "parent_id"
    users ||--o{ comments : "user_id"
    users ||--o{ posts : "user_id"
    categories |o--o{ posts : "category_id"
    users ||--o{ role_user : "user_id"
    roles ||--o{ role_user : "role_id"
    tags ||--o{ taggables : "tag_id"
    countries ||--o{ users : "country_id"
