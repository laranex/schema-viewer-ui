{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laranex.github.io/schema-viewer-ui/laranex-schema-allowlist/1.0.json",
  "title": "laranex-schema-allowlist 1.0",
  "type": "object",
  "properties": {
    "format": {
      "const": "laranex-schema-allowlist"
    },
    "version": {
      "const": "1.0"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(.*/)?\\.\\.?(/|$))[^\\\\\\u0000]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "include": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!(.*/)?\\.\\.?(/|$))[^\\\\\\u0000]+$"
          },
          "root": {
            "type": "string",
            "pattern": "^\\.$|^(?!/)(?!.*//)(?!.*/$)(?!(.*/)?\\.\\.?(/|$))[^\\\\\\u0000]+$"
          }
        },
        "required": [
          "path",
          "root"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "entries"
  ],
  "additionalProperties": false
}
