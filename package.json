{
  "name": "laranex-schema-viewer-ui",
  "version": "0.1.0",
  "description": "The unified laranex-schema contract and the shared ERD viewer for Laravel, Python and Node.js: a React component, a standalone static bundle, JSON Schema, validator, graph builder and conformance fixtures.",
  "license": "MIT",
  "author": "Laranex",
  "homepage": "https://laranex.github.io/schema-viewer-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laranex/schema-viewer-ui.git"
  },
  "bugs": {
    "url": "https://github.com/laranex/schema-viewer-ui/issues"
  },
  "keywords": [
    "erd",
    "schema",
    "database",
    "diagram",
    "react",
    "react-flow",
    "laranex"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./contract": {
      "types": "./dist/types/contract/index.d.ts",
      "import": "./dist/lib/contract.js"
    },
    "./styles.css": "./dist/lib/styles.css",
    "./schema.json": "./contract/schema.json",
    "./contract/*": "./contract/*",
    "./viewer/*": "./dist/viewer/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "contract",
    "docs/contract.md",
    "docs/integration.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config vite.viewer.config.ts",
    "build": "rm -rf dist && vite build --config vite.lib.config.ts && vite build --config vite.viewer.config.ts && node scripts/viewer-html.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && npm run contract:check && npm run test:package",
    "contract": "UPDATE_CONTRACT=1 vitest run tests/contract.test.ts",
    "contract:check": "node contract/check.mjs contract/fixtures/valid/*.json",
    "test:browser": "playwright test",
    "test:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "elkjs": "0.12.0",
    "jsdom": "30.1.3",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
